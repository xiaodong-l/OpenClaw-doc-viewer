{
  "name": "doc-viewer-backend",
  "version": "2.0.0",
  "description": "OpenClaw Doc Viewer Backend - Enterprise Edition",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run unit",
    "test:integration": "vitest run integration",
    "lint": "eslint src/**/*.js",
    "db:migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "chokidar": "^5.0.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "flexsearch": "^0.8.212",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^14.1.1",
    "nodemailer": "^8.0.2",
    "otpauth": "^9.3.4",
    "redis": "^5.11.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.8.0",
    "sinon": "^21.0.2",
    "supertest": "^7.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "doc-viewer",
    "openclaw",
    "document-management",
    "enterprise"
  ],
  "author": "OpenClaw Team",
  "license": "MIT"
}
