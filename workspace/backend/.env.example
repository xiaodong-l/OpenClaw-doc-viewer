# OpenClaw Doc Viewer Backend Configuration
# Copy this file to .env and update with your settings

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Root directories to scan for documents (comma-separated)
# Example: ROOT_DIRS=/home/user/docs,/home/user/notes
ROOT_DIRS=/path/to/your/documents

# JWT Secret (REQUIRED: Change this in production!)
# Generate a strong random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-key-change-in-production

# File Scan Settings
SCAN_DEBOUNCE_MS=1000
MAX_FILE_SIZE_MB=10

# Excluded Patterns (comma-separated)
EXCLUDE_PATTERNS=node_modules,.git,cache,tmp,logs,dist

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Redis Configuration (for session storage)
# REDIS_URL=redis://localhost:6379

# Optional: Email Configuration (for notifications - Enterprise)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# Optional: LDAP Configuration (Enterprise Edition)
# LDAP_URL=ldap://ldap.example.com
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=ldap-password
